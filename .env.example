# ============================================================================
# HAR Project — Environment Configuration
# ============================================================================
# Copy this file to `.env` and update the values below.
#
#   cp .env.example .env
#
# ============================================================================

# ── JWT Secret ───────────────────────────────────────────────────────────────
# REQUIRED for production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If not set, the API starts with a warning and uses an insecure default.
HAR_JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite at <project_root>/har_data.db
# DATABASE_URL=sqlite:///har_data.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use "*" (default) for development.
# For production, specify exact origins (credentials disabled when "*").
# HAR_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Demo Users ───────────────────────────────────────────────────────────────
# Set to "true" to seed demo accounts on startup:
#   admin / password
#   user  / password
# Default: false (demo users NOT created)
HAR_SEED_DEMO_USERS=false
